{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/kiss_component/media/_image.html.twig' %}

{% set attributes = attrs(attributes|default).addClass('rsce_quote') %}
{% set media_attributes = attrs()
    .addClass([
        'shrink-0',
        'w-[300px]',
        'lg:w-[400px]',
        'xl:w-[540px]',
        'overflow-hidden',
        'rounded-tl-[50%]',
        'rounded-tr-[50%]',
    ])
    .mergeWith(media_attributes|default)
%}
{% set img_class = 'aspect-square object-cover' %}

{% block content %}
    <div class="flex flex-col md:flex-row items-end gap-8 md:gap-12">
        <div class="text md:pb-10 xl:pb-20">
            {% if name_position|default or quote_suffix|default %}
                <p class="mb-4">
                    {%- if name_position|default -%}<strong class="font-semibold">{{ name_position }}</strong>{%- endif -%}
                    {%- if quote_suffix|default %} {{ quote_suffix }}{%- endif -%}
                </p>
            {% endif %}

            {% if quote|default %}
                <blockquote class="m-0 text-primary-solid font-serif">
                    &ldquo;{{ quote }}&rdquo;
                </blockquote>
            {% endif %}
        </div>
        {{ block('image') }}
    </div>
{% endblock %}
