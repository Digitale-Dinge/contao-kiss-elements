{% use '@Contao/component/_headline.html.twig' %}
{% use '@Contao/kiss_component/media/_media_text.html.twig' %}
{% extends '@Contao/content_element/_base.html.twig' %}

{% set attributes = attrs(attributes|default).addClass('icon_text_list') %}

{% block headline %}
    {% if item.headline.value|default or item.topline|default %}
        {{ block('headline_component') }}
    {% endif %}
{% endblock %}

{%- block headline_inner -%}
    {% if icon|default %}
        {{ include('@Contao/kiss_component/media/_icon_include.html.twig') }}
    {% endif %}
    {{ parent() }}
{%- endblock -%}

{% block content %}
    {% for item in list %}
        {# Set the icon within the item scope #}
        {% set icon = item.icon %}
        {{ block('media_text') }}
    {% endfor %}
{% endblock %}
