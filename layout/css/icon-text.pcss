/* SVG icons placed inline inside headings — size follows parent font-size via 1em */
.icon_text_list {
    .svg-icon {
        width: 1em;
        height: 1em;
        display: inline-block;
        flex-shrink: 0;
        vertical-align: middle;

        /* Move up a bit to match the line height */
        position: relative;
        top: -.1em;
    }
}
